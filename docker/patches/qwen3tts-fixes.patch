diff --git a/tools/mtmd/clip.cpp b/tools/mtmd/clip.cpp
index c77e7cc..f9fd996 100644
--- a/tools/mtmd/clip.cpp
+++ b/tools/mtmd/clip.cpp
@@ -4092,6 +4092,22 @@ bool clip_encode(struct clip_ctx * ctx, struct clip_encode_params * params) {
     ggml_cgraph * gf = clip_get_graph_builder(ctx, imgs, params)->build();
     ggml_backend_sched_alloc_graph(ctx->sched.get(), gf);
 
+    // zero-fill every graph input before the stage-specific uploads below.
+    // multi-stage generators (e.g. qwen3tts_gen) run the same graph with a
+    // different subset of inputs per stage; inputs the current stage does not
+    // set would otherwise hold stale allocator memory, which is harmless where
+    // the result is unused on CUDA but trips GGML_ASSERT bounds checks in the
+    // CPU/Vulkan get_rows kernels.
+    for (int i = 0; i < ggml_graph_n_nodes(gf); i++) {
+        ggml_tensor * node = ggml_graph_node(gf, i);
+        for (int j = 0; j < GGML_MAX_SRC; j++) {
+            ggml_tensor * src = node->src[j];
+            if (src && (src->flags & GGML_TENSOR_FLAG_INPUT)) {
+                ggml_backend_tensor_memset(src, 0, 0, ggml_nbytes(src));
+            }
+        }
+    }
+
     // set inputs
     const auto & model   = ctx->model;
     const auto & hparams = model.hparams;
