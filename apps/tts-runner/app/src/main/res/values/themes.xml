<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.TTSRunner" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowLightStatusBar">?attr/isLightTheme</item>
        <!-- targetSdk 35 makes Android 15 force edge-to-edge; these screens lay
             their own padding and do not consume window insets, so opt out of
             the enforcement for now (the flag is a no-op below API 35). Handle
             insets properly before this is removed in a later Android. -->
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
    </style>

    <!-- Floating share-sheet target. Must be a full theme, not a
         ThemeOverlay: an overlay leaves framework attributes unset, and on
         One UI that surfaced as "Failed to resolve attribute at index 6"
         (android:textColorHighlight) the moment ShareActivity built its first
         TextView, so every share crashed. -->
    <style name="Theme.TTSRunner.Dialog" parent="Theme.Material3.DayNight.Dialog.Alert">
        <item name="android:windowCloseOnTouchOutside">false</item>
        <!-- the activity draws its own heading; the window title would repeat it -->
        <item name="windowNoTitle">true</item>
        <item name="windowActionBar">false</item>
    </style>
</resources>
