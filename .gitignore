# Gradle / Android build products (builds run in Docker, nothing here is source)
**/build/
**/.gradle/
output/
local.properties

# Signing key: generated per-clone by build.sh (never committed — a shared
# private key in a public repo is worthless anyway)
keystore/

# IDE
.idea/
*.iml

# CMake/NDK intermediates (bind-mounted build tree)
**/.cxx/

# Python bytecode from the tooling scripts
__pycache__/
